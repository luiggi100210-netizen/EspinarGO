# =============================================================================
# ESPINARGO - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como .env y reemplaza los valores con los tuyos
# =============================================================================

# =============================================================================
# APP - Configuración general de la aplicación
# =============================================================================
APP_NAME="EspinarGo API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# DATABASE - Configuración de PostgreSQL
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/espinargo_db
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/espinargo_db

# =============================================================================
# REDIS - Configuración de cache y sesiones
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT - Configuración de tokens de autenticación
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# OTP SMS - Configuración de Twilio para envío de códigos SMS
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# =============================================================================
# EMAIL - Configuración de Resend para emails transaccionales
# =============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@espinargo.com
FROM_NAME=EspinarGo

# =============================================================================
# CLOUDINARY - Configuración de almacenamiento de imágenes y documentos
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# OAUTH - Configuración de login social (Google y Facebook)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# =============================================================================
# SENTRY - Configuración de monitoreo de errores
# =============================================================================
SENTRY_DSN=